# Auto Cut 环境变量示例
# 复制为 .env 并填写实际值

# API 鉴权 Token（必填）
AUTOCUT_API_TOKEN=changeme-please-set-a-strong-token

# LLM 接口（可选，不填则跳过 AI 评分/remix）
AUTOCUT_LLM_API_URL=https://model-api.example.com/v1/chat/completions
AUTOCUT_LLM_MODEL=deepseek-v3.2
AUTOCUT_LLM_API_KEY=sk-your-api-key-here
# 若 LLM 网关 HTTPS 握手被主动断开，确认内网 HTTP 可用后再开启明文降级
# AUTOCUT_LLM_HTTP_FALLBACK=1

# 远端 ASR 接口（可选；不填时 whisper-api 会回退使用 AUTOCUT_LLM_API_URL/API_KEY）
AUTOCUT_ASR_API_URL=https://model-api.example.com/v1/audio/transcriptions
AUTOCUT_ASR_API_KEY=sk-your-api-key-here
# 远端 whisper-large-v3 对部分 MP3 可能只返回稀疏片段；默认建议上传 WAV
AUTOCUT_ASR_UPLOAD_FORMAT=wav
# 默认不发送 language，以贴近已验证的 curl；如服务端需要再开启
# AUTOCUT_ASR_SEND_LANGUAGE=1
# 默认不发送 prompt/热词，以贴近已验证的 curl；如服务端兼容再开启
# AUTOCUT_ASR_SEND_PROMPT=1
# 整段 ASR 若只返回少量片段，自动按 30 秒切块重试
AUTOCUT_ASR_CHUNK_RETRY=1
AUTOCUT_ASR_CHUNK_SECONDS=30
# 若远端网关 HTTPS 握手被主动断开，确认内网 HTTP 可用后再开启明文降级
# AUTOCUT_ASR_HTTP_FALLBACK=1
